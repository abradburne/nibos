From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alan Bradburne <abradburne@gmail.com>
Date: Fri, 16 Oct 2026 07:45:13 +0900
Subject: [PATCH 1/4] cmd: bootstage: add "bootstage mark <name>"

Record a boot stage by name from the command line, so a boot command can
time its own steps (SD init, loading the kernel, unpacking it) next to
the stages U-Boot records itself. nibOS's measuring build (MEASURE=1)
marks each step of its boot command this way and stashes the records for
Linux to read.

The name is strdup()ed: bootstage keeps the pointer, and the command
line's buffer is reused.

Upstream status: candidate.
---
 cmd/bootstage.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/cmd/bootstage.c b/cmd/bootstage.c
index 5c6d5a3a..f61a52ce 100644
--- a/cmd/bootstage.c
+++ b/cmd/bootstage.c
@@ -7,6 +7,7 @@
 #include <command.h>
 #include <vsprintf.h>
 #include <linux/string.h>
+#include <malloc.h>
 
 static int do_bootstage_report(struct cmd_tbl *cmdtp, int flag, int argc,
 			       char *const argv[])
@@ -62,8 +63,19 @@ static int do_bootstage_stash(struct cmd_tbl *cmdtp, int flag, int argc,
 }
 #endif
 
+static int do_bootstage_mark(struct cmd_tbl *cmdtp, int flag, int argc,
+			     char *const argv[])
+{
+	if (argc < 2)
+		return CMD_RET_USAGE;
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, strdup(argv[1]));
+
+	return 0;
+}
+
 static struct cmd_tbl cmd_bootstage_sub[] = {
 	U_BOOT_CMD_MKENT(report, 2, 1, do_bootstage_report, "", ""),
+	U_BOOT_CMD_MKENT(mark, 2, 1, do_bootstage_mark, "", ""),
 #if IS_ENABLED(CONFIG_BOOTSTAGE_STASH)
 	U_BOOT_CMD_MKENT(stash, 4, 0, do_bootstage_stash, "", ""),
 	U_BOOT_CMD_MKENT(unstash, 4, 0, do_bootstage_stash, "", ""),
@@ -95,6 +107,7 @@ U_BOOT_CMD(bootstage, 4, 1, do_boostage,
 	"Boot stage command",
 	" - check boot progress and timing\n"
 	"report                      - Print a report\n"
+	"mark <name>                 - Record a boot stage now\n"
 #if IS_ENABLED(CONFIG_BOOTSTAGE_STASH)
 	"stash [<start> [<size>]]    - Stash data into memory\n"
 	"unstash [<start> [<size>]]  - Unstash data from memory\n"

