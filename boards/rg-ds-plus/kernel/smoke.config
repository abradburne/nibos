# nibOS: the RG DS+'s firmware-loading drivers, built in for the smoke-test
# kernel (SMOKE=1 kernel/build.sh), whose initramfs has their firmware
# (smoke-firmware).
CONFIG_RTW88=y
CONFIG_RTW88_CORE=y
CONFIG_RTW88_SDIO=y
CONFIG_RTW88_8821C=y
CONFIG_RTW88_8821CS=y
CONFIG_BT_HCIUART=y
CONFIG_BT_RTL=y
CONFIG_SND_SOC_AW88166=y
CONFIG_TOUCHSCREEN_GOODIX=y
