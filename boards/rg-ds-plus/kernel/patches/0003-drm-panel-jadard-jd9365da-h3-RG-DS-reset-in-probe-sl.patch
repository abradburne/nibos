From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alan Bradburne <abradburne@gmail.com>
Date: Fri, 16 Oct 2026 12:20:38 +0900
Subject: [PATCH 3/3] drm/panel: jadard-jd9365da-h3: RG DS+: reset in probe,
 sleep-out wait in enable

On the RG DS+ both panels went through their whole power-on one after
the other inside DRM's first modeset: reset (5 + 10 + 130 ms), ~80 ms of
init commands at LP speed, sleep-out (120 ms) and display-on (20 ms).

DRM prepares every panel before it enables any, so the RG DS+ panel now
stops after sending sleep-out in prepare and waits out the rest of the
120 ms in a new enable hook: the second panel is initialised while the
first one waits. The power-on and reset pulse move to the (asynchronous)
probe, so both panels reset together before the modeset starts, and
prepare only sleeps for what is left of the 130 ms after reset. The
commands and minimum delays are unchanged; the panels come on at 0.55
and 0.61 s into the kernel instead of 0.70 and 0.84 s. A debug build read
each panel's DCS power mode back after display-on (0x14: sleep out,
display on) on every test boot.

Other panels in the driver are unaffected: both changes are opt-in
through the panel description (reset_in_probe, enable).

Upstream status: board-specific as written. Powering a panel up in
probe, before the host is ready, is not how panel drivers are expected
to work; the prepare/enable split alone could be proposed.
---
 .../gpu/drm/panel/panel-jadard-jd9365da-h3.c  | 89 ++++++++++++++++++-
 1 file changed, 86 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
index e597a0c18..8ee92f9b4 100644
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -31,7 +31,9 @@ struct jadard_panel_desc {
 	unsigned int lanes;
 	enum mipi_dsi_pixel_format format;
 	int (*init)(struct jadard *jadard);
+	int (*enable)(struct jadard *jadard);
 	bool lp11_before_reset;
+	bool reset_in_probe;
 	bool reset_before_power_off_vcioo;
 	unsigned int vcioo_to_lp11_delay_ms;
 	unsigned int lp11_to_reset_delay_ms;
@@ -49,6 +51,9 @@ struct jadard {
 	struct regulator *vdd;
 	struct regulator *vccio;
 	struct gpio_desc *reset;
+	ktime_t sleep_out_at;
+	ktime_t reset_at;
+	bool powered;
 };
 
 #define JD9365DA_DCS_SWITCH_PAGE	0xe0
@@ -98,6 +103,16 @@ static int jadard_prepare(struct drm_panel *panel)
 	struct jadard *jadard = panel_to_jadard(panel);
 	int ret;
 
+	if (jadard->powered) {
+		s64 since = ktime_ms_delta(ktime_get(), jadard->reset_at);
+
+		jadard->powered = false;
+		if (since < 130)
+			msleep(130 - since);
+
+		return jadard->desc->init(jadard);
+	}
+
 	ret = regulator_enable(jadard->vccio);
 	if (ret)
 		return ret;
@@ -153,6 +168,16 @@ static int jadard_unprepare(struct drm_panel *panel)
 	return 0;
 }
 
+static int jadard_enable(struct drm_panel *panel)
+{
+	struct jadard *jadard = panel_to_jadard(panel);
+
+	if (!jadard->desc->enable)
+		return 0;
+
+	return jadard->desc->enable(jadard);
+}
+
 static int jadard_get_modes(struct drm_panel *panel,
 			    struct drm_connector *connector)
 {
@@ -175,6 +200,7 @@ static const struct drm_panel_funcs jadard_funcs = {
 	.disable = jadard_disable,
 	.unprepare = jadard_unprepare,
 	.prepare = jadard_prepare,
+	.enable = jadard_enable,
 	.get_modes = jadard_get_modes,
 	.get_orientation = jadard_panel_get_orientation,
 };
@@ -1430,7 +1456,25 @@ static int anbernic_rgds_plus_init_cmds(struct jadard *jadard)
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x00);
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
-	mipi_dsi_msleep(&dsi_ctx, 120);
+	jadard->sleep_out_at = ktime_get();
+
+	return dsi_ctx.accum_err;
+};
+
+/*
+ * The rest of the power-on sequence, from enable rather than prepare: DRM
+ * prepares every panel before it enables any, so with two panels the second
+ * one's reset and init run while the first one waits out its sleep-out time,
+ * instead of after it.
+ */
+static int anbernic_rgds_plus_enable(struct jadard *jadard)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = jadard->dsi };
+	struct drm_panel *panel = &jadard->panel;
+	s64 since = ktime_ms_delta(ktime_get(), jadard->sleep_out_at);
+
+	if (since < 120)
+		mipi_dsi_msleep(&dsi_ctx, 120 - since);
 
 	if (of_device_is_compatible(panel->dev->of_node,
 				    "anbernic,rg-ds-plus-display-top"))
@@ -1440,7 +1484,7 @@ static int anbernic_rgds_plus_init_cmds(struct jadard *jadard)
 	mipi_dsi_msleep(&dsi_ctx, 20);
 
 	return dsi_ctx.accum_err;
-};
+}
 
 static const struct jadard_panel_desc anbernic_rgds_plus_display_desc = {
 	.mode_2ln = &(const struct drm_display_mode) {
@@ -1465,6 +1509,8 @@ static const struct jadard_panel_desc anbernic_rgds_plus_display_desc = {
 	.lanes = 2,
 	.format = MIPI_DSI_FMT_RGB888,
 	.init = anbernic_rgds_plus_init_cmds,
+	.enable = anbernic_rgds_plus_enable,
+	.reset_in_probe = true,
 	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 		      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS |
 		      MIPI_DSI_MODE_LPM,
@@ -3354,6 +3400,32 @@ static int jadard_dsi_probe(struct mipi_dsi_device *dsi)
 
 	jadard->panel.prepare_prev_first = true;
 
+	/*
+	 * Power the panel on and reset it here, not in prepare: the probe runs
+	 * asynchronously, so both panels' resets and post-reset waits overlap
+	 * each other and the rest of the boot instead of running one after the
+	 * other in the first modeset. prepare waits out whatever is left.
+	 */
+	if (desc->reset_in_probe) {
+		ret = regulator_enable(jadard->vccio);
+		if (ret)
+			return ret;
+
+		ret = regulator_enable(jadard->vdd);
+		if (ret) {
+			regulator_disable(jadard->vccio);
+			return ret;
+		}
+
+		gpiod_set_value_cansleep(jadard->reset, 0);
+		msleep(5);
+		gpiod_set_value_cansleep(jadard->reset, 1);
+		msleep(10);
+		gpiod_set_value_cansleep(jadard->reset, 0);
+		jadard->reset_at = ktime_get();
+		jadard->powered = true;
+	}
+
 	drm_panel_add(&jadard->panel);
 
 	mipi_dsi_set_drvdata(dsi, jadard);
@@ -3361,8 +3433,14 @@ static int jadard_dsi_probe(struct mipi_dsi_device *dsi)
 	jadard->desc = desc;
 
 	ret = mipi_dsi_attach(dsi);
-	if (ret < 0)
+	if (ret < 0) {
 		drm_panel_remove(&jadard->panel);
+		if (jadard->powered) {
+			jadard->powered = false;
+			regulator_disable(jadard->vdd);
+			regulator_disable(jadard->vccio);
+		}
+	}
 
 	return ret;
 }
@@ -3373,6 +3451,11 @@ static void jadard_dsi_remove(struct mipi_dsi_device *dsi)
 
 	mipi_dsi_detach(dsi);
 	drm_panel_remove(&jadard->panel);
+
+	if (jadard->powered) {
+		regulator_disable(jadard->vdd);
+		regulator_disable(jadard->vccio);
+	}
 }
 
 static const struct of_device_id jadard_of_match[] = {
