From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alan Bradburne <abradburne@gmail.com>
Date: Thu, 15 Oct 2026 21:30:56 +0900
Subject: [PATCH 1/3] drm/panel: jadard-jd9365da-h3: add Anbernic RG DS+ panels
 (JD9165)

The Anbernic RG DS+ has two 1024x768 MIPI-DSI panels, each driven over
two lanes by a Jadard JD9165 controller. The JD9165 shares the JD9365's
power and reset sequence but switches register pages with 0x30 and is
unlocked with 0xf7, so it gets its own init function.

The init commands, timings (1304x800 total, 62.8 MHz, 60.2 Hz) and lane
setup are the stock firmware's (V1.0, 2026-09-15), decoded from its
device tree's panel-init-sequence properties, where they are sent as
generic long writes. The top panel is mounted upside down and flips its
scan direction with MADCTL (0x03); it is told apart by its compatible.

Upstream status: candidate. Needs the matching DT binding (compatibles
anbernic,rg-ds-plus-display-top and -bottom) to go with it.
---
 .../gpu/drm/panel/panel-jadard-jd9365da-h3.c  | 117 ++++++++++++++++++
 1 file changed, 117 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
index 5202c1ffc..b100b0482 100644
--- a/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
+++ b/drivers/gpu/drm/panel/panel-jadard-jd9365da-h3.c
@@ -1361,6 +1361,115 @@ static const struct jadard_panel_desc anbernic_rgds_display_desc = {
 		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
 };
 
+/*
+ * The RG DS+ panels use a Jadard JD9165 controller, not a JD9365: pages are
+ * switched with register 0x30 and the sequence is unlocked with 0xf7. The
+ * commands below are the stock firmware's (V1.0 20260915), which sends them as
+ * generic long writes. The top panel is mounted upside down and flips its scan
+ * direction with MADCTL.
+ */
+static int anbernic_rgds_plus_init_cmds(struct jadard *jadard)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = jadard->dsi };
+	struct drm_panel *panel = &jadard->panel;
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xf7, 0x49, 0x61, 0x02, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x04, 0x0c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0b, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x20, 0x04);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x25, 0x19);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x28, 0x18);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x02);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x00, 0x11);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x01, 0x26);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x02, 0x10);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x05, 0x68);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x06, 0x80);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0b, 0x0d, 0x0d, 0x03, 0x0d,
+					 0x03, 0x0d, 0x03, 0x03, 0x15, 0x08, 0x06);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0c, 0x1d, 0x1f, 0x25, 0x27,
+					 0x29, 0x2b, 0x16, 0x21, 0x0d, 0x0b, 0x0d);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0d, 0x0d, 0x0d, 0x03, 0x0d,
+					 0x03, 0x0d, 0x03, 0x03, 0x15, 0x09, 0x07);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0e, 0x1c, 0x1e, 0x24, 0x26,
+					 0x28, 0x2a, 0x0a, 0x20, 0x0d, 0x0b, 0x0d);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0f, 0x0d, 0x0d, 0x03, 0x0d,
+					 0x0b, 0x0d, 0x03, 0x03, 0x15, 0x2a, 0x28);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x10, 0x26, 0x24, 0x1e, 0x1c,
+					 0x07, 0x09, 0x20, 0x0a, 0x0d, 0x03, 0x0d);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x11, 0x0d, 0x0d, 0x03, 0x0d,
+					 0x0b, 0x0d, 0x03, 0x03, 0x15, 0x2b, 0x29);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x12, 0x27, 0x25, 0x1f, 0x1d,
+					 0x06, 0x08, 0x21, 0x16, 0x0d, 0x03, 0x0d);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x13, 0x00, 0x00, 0x41, 0x41);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x14, 0x00, 0x00, 0x41, 0x41);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x1a, 0x0b, 0x14);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x06);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x12, 0x3f, 0x24, 0x23, 0x30,
+					 0x26, 0x2d, 0x34, 0x38, 0x3b, 0x32, 0x22,
+					 0x18, 0x12, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x13, 0x3f, 0x24, 0x23, 0x30,
+					 0x26, 0x2c, 0x33, 0x37, 0x3a, 0x31, 0x22,
+					 0x18, 0x12, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x07);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0d, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x08);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x05, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0c, 0x1a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0d, 0x0e);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x0a);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x02, 0x4f);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x0b, 0x40);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x0d);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x10, 0x0c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x11, 0x0c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x12, 0x0c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x13, 0x0c);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x30, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	if (of_device_is_compatible(panel->dev->of_node,
+				    "anbernic,rg-ds-plus-display-top"))
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_ADDRESS_MODE, 0x03);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+};
+
+static const struct jadard_panel_desc anbernic_rgds_plus_display_desc = {
+	.mode_2ln = &(const struct drm_display_mode) {
+		.clock		= 62800,
+
+		.hdisplay	= 1024,
+		.hsync_start	= 1024 + 120,
+		.hsync_end	= 1024 + 120 + 80,
+		.htotal		= 1024 + 120 + 80 + 80,
+
+		.vdisplay	= 768,
+		.vsync_start	= 768 + 16,
+		.vsync_end	= 768 + 16 + 8,
+		.vtotal		= 768 + 16 + 8 + 8,
+
+		/* Not given by the stock firmware; 4" at 4:3. */
+		.width_mm	= 81,
+		.height_mm	= 61,
+		.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+		.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+	},
+	.lanes = 2,
+	.format = MIPI_DSI_FMT_RGB888,
+	.init = anbernic_rgds_plus_init_cmds,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		      MIPI_DSI_MODE_LPM,
+};
+
 static int taiguan_xti05101_01a_init_cmds(struct jadard *jadard)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = jadard->dsi };
@@ -3275,6 +3384,14 @@ static const struct of_device_id jadard_of_match[] = {
 		.compatible = "anbernic,rg-ds-display-top",
 		.data = &anbernic_rgds_display_desc
 	},
+	{
+		.compatible = "anbernic,rg-ds-plus-display-bottom",
+		.data = &anbernic_rgds_plus_display_desc
+	},
+	{
+		.compatible = "anbernic,rg-ds-plus-display-top",
+		.data = &anbernic_rgds_plus_display_desc
+	},
 	{
 		.compatible = "chongzhou,cz101b4001",
 		.data = &cz101b4001_desc

