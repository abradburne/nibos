# nibOS: the RG DS+'s parts, and the hardware it doesn't have. Merged last, after
# kernel/nibos.config and socs/rk3568/kernel/rk3568.config. defconfig already
# covers most of the board; these are the rest. Built in where nothing needs
# firmware: the kernel only runs on this board.

# --- What is on the board ---------------------------------------------------------

# Two JD9165 panels on the Jadard driver (boards/rg-ds-plus/kernel/patches),
# PWM backlights.
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
CONFIG_BACKLIGHT_PWM=y
# The RK817 PMIC (regulators, charger, codec), the FAN53555 CPU regulator and
# the CW2015 fuel gauge.
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_CHARGER_RK817=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_BATTERY_CW2015=y
# Sound: the RK817 codec (headphones, microphone) and two AW88166 speaker
# amps, which load a tuning file (stock/aw88166_acf.bin): a module.
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SOC_AW88166=m
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_AUDIO_GRAPH_CARD2=y
# Buttons on GPIOs and an ADC ladder, the stick on the SAR ADC through a mux,
# the rumble motor.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_ADC=y
CONFIG_IIO_MUX=y
CONFIG_MUX_GPIO=y
CONFIG_INPUT_PWM_VIBRA=y
# The GT9xx touch controller of the bottom panel loads its configuration:
# a module.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
# RTL8821CS: Wi-Fi on SDIO and Bluetooth on a UART, both with firmware.
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_SDIO=m
CONFIG_RTW88_8821C=m
CONFIG_RTW88_8821CS=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_RTL=m
# The ICM42607 IMU the stock tree describes: it probes and finds nothing, so a
# module keeps its 0.1 s out of the boot.
CONFIG_INV_ICM42607_I2C=m
# LEDs on GPIOs; the panels' reset lines through the reset framework.
CONFIG_LEDS_GPIO=y
CONFIG_RESET_GPIO=y

# --- What isn't ---------------------------------------------------------------------

# No PCIe, SATA, raw flash, UFS, eMMC (SDHCI) or SAS: two microSD slots.
# CONFIG_PCI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_SCSI_LOWLEVEL is not set
# CONFIG_SCSI_SAS_ATTRS is not set
# CONFIG_MMC_SDHCI is not set
# No wired network or CAN bus.
# CONFIG_ETHERNET is not set
# CONFIG_NET_DSA is not set
# CONFIG_CAN is not set
CONFIG_PHYLIB=m
# CONFIG_MDIO_BUS_MUX is not set
# Other boards' PMICs, regulators, RTCs, clock generators, fuel gauges and
# I2C/GPIO expanders.
# CONFIG_MFD_BD9571MWV is not set
# CONFIG_MFD_AXP20X is not set
# CONFIG_MFD_AXP20X_I2C is not set
# CONFIG_MFD_HI6421_PMIC is not set
# CONFIG_MFD_MAX77620 is not set
# CONFIG_MFD_MT6360 is not set
# CONFIG_MFD_MT6397 is not set
# CONFIG_MFD_RK8XX_SPI is not set
# CONFIG_MFD_SEC_CORE is not set
# CONFIG_MFD_SEC_I2C is not set
# CONFIG_MFD_TPS65219 is not set
# CONFIG_MFD_ROHM_BD718XX is not set
# CONFIG_REGULATOR_HI6421V530 is not set
# CONFIG_REGULATOR_MAX8973 is not set
# CONFIG_REGULATOR_MP8859 is not set
# CONFIG_REGULATOR_MT6357 is not set
# CONFIG_REGULATOR_MT6358 is not set
# CONFIG_REGULATOR_MT6359 is not set
# CONFIG_REGULATOR_PCA9450 is not set
# CONFIG_REGULATOR_PF8X00 is not set
# CONFIG_REGULATOR_PFUZE100 is not set
# CONFIG_REGULATOR_QCOM_SPMI is not set
# CONFIG_REGULATOR_RAA215300 is not set
# CONFIG_REGULATOR_S2MPS11 is not set
# CONFIG_RTC_DRV_MAX77686 is not set
# CONFIG_RTC_DRV_S5M is not set
# CONFIG_RTC_DRV_DS3232 is not set
# CONFIG_COMMON_CLK_VC3 is not set
# CONFIG_COMMON_CLK_VC5 is not set
# CONFIG_COMMON_CLK_CS2000_CP is not set
# CONFIG_COMMON_CLK_RS9_PCIE is not set
# CONFIG_COMMON_CLK_S2MPS11 is not set
# CONFIG_BATTERY_BQ27XXX is not set
# CONFIG_PINCTRL_MAX77620 is not set
# CONFIG_I2C_MUX_PCA954x is not set
