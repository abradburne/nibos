# nibOS: the RG DS+'s Falcon SPL (FALCON=1 uboot/build.sh). SPL switches the SD
# card to 1.8 V for UHS SDR104 itself, through the RK817 PMIC on I2C.
CONFIG_SPL_I2C=y
CONFIG_SPL_PMIC_RK8XX=y
CONFIG_SPL_REGULATOR_RK8XX=y
# A/B slots (rg-ds-plus/0004): SPL writes the boot control block while a slot is on trial,
# and checks it with a CRC-32.
CONFIG_SPL_MMC_WRITE=y
CONFIG_SPL_CRC32=y
