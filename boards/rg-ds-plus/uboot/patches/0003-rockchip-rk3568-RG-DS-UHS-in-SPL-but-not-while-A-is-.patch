From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alan Bradburne <abradburne@gmail.com>
Date: Fri, 16 Oct 2026 16:07:44 +0900
Subject: [PATCH 3/3] rockchip: rk3568: RG DS: UHS in SPL, but not while A is
 held

Falcon mode has SPL read the 17.5 MB uncompressed kernel, which at High
Speed took 0.73 s and lost to U-Boot proper; at UHS SDR104 it takes
0.25 s. SPL needs the SD pads' IO domain for that, so pmu_io_domains
gets bootph-pre-ram in the RG DS U-Boot device tree.

A UHS init that hangs in SPL would take the A-held escape hatch with it,
since SPL sets the card up before it asks which U-Boot to load. So the
board says no UHS while A is held, through a weak
rockchip_dwmmc_board_no_uhs() the dw_mmc glue asks.

Upstream status: board-specific, not for upstream (goes with the
escape-hatch patch); the bootph-pre-ram node could go on its own.
---
 .../arm/dts/rk3568-anbernic-rg-ds-u-boot.dtsi |  8 ++++++++
 arch/arm/mach-rockchip/rk3568/rk3568.c        | 20 ++++++++++++++++---
 drivers/mmc/rockchip_dw_mmc.c                 |  8 +++++++-
 3 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/arch/arm/dts/rk3568-anbernic-rg-ds-u-boot.dtsi b/arch/arm/dts/rk3568-anbernic-rg-ds-u-boot.dtsi
index 79446108..ec703c47 100644
--- a/arch/arm/dts/rk3568-anbernic-rg-ds-u-boot.dtsi
+++ b/arch/arm/dts/rk3568-anbernic-rg-ds-u-boot.dtsi
@@ -39,3 +39,11 @@
 &vccio_sd {
 	bootph-pre-ram;
 };
+
+/*
+ * UHS in SPL (Falcon builds): the SD pads' IO domain must follow vccio_sd
+ * there too.
+ */
+&pmu_io_domains {
+	bootph-pre-ram;
+};
diff --git a/arch/arm/mach-rockchip/rk3568/rk3568.c b/arch/arm/mach-rockchip/rk3568/rk3568.c
index 37adb88a..766b73ab 100644
--- a/arch/arm/mach-rockchip/rk3568/rk3568.c
+++ b/arch/arm/mach-rockchip/rk3568/rk3568.c
@@ -239,8 +239,7 @@ int checkboard(void)
 #define HATCH_PIN		7	/* B7 */
 #define HATCH_BIT		(8 + HATCH_PIN)
 
-unsigned long board_spl_mmc_get_uboot_raw_sector(struct mmc *mmc,
-						 unsigned long raw_sect)
+static bool hatch_held(void)
 {
 	/* GPIO function, pull-up, input */
 	writel(0xf << ((HATCH_PIN - 4) * 4 + 16), GRF_GPIO3B_IOMUX_H);
@@ -249,7 +248,22 @@ unsigned long board_spl_mmc_get_uboot_raw_sector(struct mmc *mmc,
 	writel(1 << (HATCH_BIT + 16), GPIO3_BASE + GPIO_SWPORT_DDR_L);
 	udelay(100);
 
-	if (!(readl(GPIO3_BASE + GPIO_EXT_PORT) & BIT(HATCH_BIT)))
+	return !(readl(GPIO3_BASE + GPIO_EXT_PORT) & BIT(HATCH_BIT));
+}
+
+/*
+ * SPL sets the card up before it asks for the U-Boot sector: with A held, no
+ * UHS there, so a UHS init that hangs can't take the escape hatch with it.
+ */
+bool rockchip_dwmmc_board_no_uhs(void)
+{
+	return hatch_held();
+}
+
+unsigned long board_spl_mmc_get_uboot_raw_sector(struct mmc *mmc,
+						 unsigned long raw_sect)
+{
+	if (hatch_held())
 		return FALLBACK_SECTOR;
 
 	return raw_sect;
diff --git a/drivers/mmc/rockchip_dw_mmc.c b/drivers/mmc/rockchip_dw_mmc.c
index bd799b73..9fe876cb 100644
--- a/drivers/mmc/rockchip_dw_mmc.c
+++ b/drivers/mmc/rockchip_dw_mmc.c
@@ -223,6 +223,11 @@ static const struct dm_mmc_ops rockchip_dwmmc_ops = {
  * UHS needs 1.8 V signalling, an IO domain that follows vqmmc, and phases
  * we can set (RK3568 only here). Anything missing leaves High Speed.
  */
+__weak bool rockchip_dwmmc_board_no_uhs(void)
+{
+	return false;
+}
+
 static void rockchip_dwmmc_setup_uhs(struct udevice *dev,
 				     struct mmc_config *cfg)
 {
@@ -232,7 +237,8 @@ static void rockchip_dwmmc_setup_uhs(struct udevice *dev,
 
 	if (!CONFIG_IS_ENABLED(MMC_UHS_SUPPORT) ||
 	    !dev_read_bool(dev, "sd-uhs-sdr104") ||
-	    !device_is_compatible(dev, "rockchip,rk3568-dw-mshc"))
+	    !device_is_compatible(dev, "rockchip,rk3568-dw-mshc") ||
+	    rockchip_dwmmc_board_no_uhs())
 		return;
 
 	if (clk_get_by_name(dev, "ciu-drive", &drv) ||
