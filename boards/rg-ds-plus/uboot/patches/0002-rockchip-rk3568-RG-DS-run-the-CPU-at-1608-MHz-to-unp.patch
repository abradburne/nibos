From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alan Bradburne <abradburne@gmail.com>
Date: Fri, 16 Oct 2026 09:51:13 +0900
Subject: [PATCH 2/3] rockchip: rk3568: RG DS: run the CPU at 1608 MHz to
 unpack the kernel

U-Boot leaves the RK3568's cores at 816 MHz (0.85 V), and unpacking the
kernel is CPU-bound: gunzip of the 11.75 MB kernel took 0.54 s. From
rk_board_late_init(), raise vdd_cpu to 1.1 V and ARMCLK to 1608 MHz, one
of Linux's operating points for this chip, before the boot command runs;
Linux's cpufreq takes over from there. gunzip then takes 0.28 s. Any
failure leaves the cores at 816 MHz. The rate is added to the CRU's CPU
table; clk_rk3568.c only records the first ARMCLK rate asked for and sets
the next, hence the double clk_set_rate().

Upstream status: board-specific, not for upstream as written; the rate
table entry could go on its own.
---
 arch/arm/mach-rockchip/rk3568/rk3568.c | 45 ++++++++++++++++++++++++++
 drivers/clk/rockchip/clk_rk3568.c      |  1 +
 2 files changed, 46 insertions(+)

diff --git a/arch/arm/mach-rockchip/rk3568/rk3568.c b/arch/arm/mach-rockchip/rk3568/rk3568.c
index c7e61cba..37adb88a 100644
--- a/arch/arm/mach-rockchip/rk3568/rk3568.c
+++ b/arch/arm/mach-rockchip/rk3568/rk3568.c
@@ -255,3 +255,48 @@ unsigned long board_spl_mmc_get_uboot_raw_sector(struct mmc *mmc,
 	return raw_sect;
 }
 #endif
+
+#if !IS_ENABLED(CONFIG_XPL_BUILD) && IS_ENABLED(CONFIG_TARGET_ANBERNIC_RG_DS_RK3568)
+#include <bootstage.h>
+#include <clk.h>
+#include <linux/delay.h>
+#include <power/regulator.h>
+
+/*
+ * Unpacking the kernel is CPU-bound, and U-Boot runs the cores at 816 MHz
+ * (0.85 V). Go to 1608 MHz at 1.1 V, one of Linux's operating points for this
+ * chip; Linux's cpufreq takes over from there. Anything failing leaves the
+ * cores at 816 MHz.
+ */
+#define BOOT_CPU_UV	1100000
+#define BOOT_CPU_HZ	1608000000
+
+int rk_board_late_init(void)
+{
+	struct udevice *reg, *cru;
+	struct clk clk = { .id = ARMCLK };
+	int ret;
+
+	ret = regulator_get_by_platname("vdd_cpu", &reg);
+	if (!ret)
+		ret = regulator_set_value(reg, BOOT_CPU_UV);
+	if (ret)
+		return 0;
+	udelay(1000);	/* ramps at 2.3 mV/us */
+	if (regulator_get_value(reg) < BOOT_CPU_UV)
+		return 0;
+
+	ret = uclass_get_device_by_driver(UCLASS_CLK,
+					  DM_DRIVER_GET(rockchip_rk3568_cru),
+					  &cru);
+	if (ret)
+		return 0;
+	clk.dev = cru;
+	/* clk_rk3568.c only records the first ARMCLK rate and sets the next */
+	clk_set_rate(&clk, BOOT_CPU_HZ);
+	clk_set_rate(&clk, BOOT_CPU_HZ);
+	bootstage_mark_name(BOOTSTAGE_ID_ALLOC, "cpu_1608mhz");
+
+	return 0;
+}
+#endif
diff --git a/drivers/clk/rockchip/clk_rk3568.c b/drivers/clk/rockchip/clk_rk3568.c
index 307a591e..f1ecef46 100644
--- a/drivers/clk/rockchip/clk_rk3568.c
+++ b/drivers/clk/rockchip/clk_rk3568.c
@@ -36,6 +36,7 @@ struct rk3568_pmuclk_plat {
 #define DIV_TO_RATE(input_rate, div)    ((input_rate) / ((div) + 1))
 
 static struct rockchip_cpu_rate_table rk3568_cpu_rates[] = {
+	RK3568_CPUCLK_RATE(1608000000, 1, 5),
 	RK3568_CPUCLK_RATE(1416000000, 1, 5),
 	RK3568_CPUCLK_RATE(1296000000, 1, 5),
 	RK3568_CPUCLK_RATE(1200000000, 1, 3),
