# nibOS: the RK3568's blocks built in, and the drivers for other SoCs off.
# Merged after kernel/nibos.config and before the board's fragment. build.sh
# also turns off every ARCH_* platform but ARCH_ROCKCHIP (soc.sh) beforehand.

# --- The SoC's own blocks, built in -------------------------------------------

# Display: VOP2, the MIPI DSI controllers and their D-PHYs, PWM backlights.
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_PWM_ROCKCHIP=y
# The Mali-G52.
CONFIG_DRM_PANFROST=y
# I2S/TDM, the SAR ADC (sticks, buttons on a ladder), thermal sensors.
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_ROCKCHIP_THERMAL=y
# USB: the OTG port (DWC3) and the host port (EHCI/OHCI).
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# Four Cortex-A55 cores, which have neither SVE nor SME.
CONFIG_NR_CPUS=4
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set

