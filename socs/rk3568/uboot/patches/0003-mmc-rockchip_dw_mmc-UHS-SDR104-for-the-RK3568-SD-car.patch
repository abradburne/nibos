diff --git a/drivers/misc/rockchip-io-domain.c b/drivers/misc/rockchip-io-domain.c
index a0573c52..af346ebf 100644
--- a/drivers/misc/rockchip-io-domain.c
+++ b/drivers/misc/rockchip-io-domain.c
@@ -7,7 +7,10 @@
 
 #include <dm.h>
 #include <dm/device_compat.h>
+#include <dm/device-internal.h>
+#include <dm/uclass-internal.h>
 #include <regmap.h>
+#include <rockchip-io-domain.h>
 #include <syscon.h>
 #include <power/regulator.h>
 
@@ -93,6 +96,11 @@ static int rk3568_iodomain_write(struct regmap *grf, uint offset, int idx, int u
 	return 0;
 }
 
+struct rockchip_iodomain_priv {
+	const struct rockchip_iodomain_soc_data *soc_data;
+	struct regmap *grf;
+};
+
 static int rockchip_iodomain_write(struct regmap *grf, uint offset, int idx, int uV)
 {
 	u32 val;
@@ -331,9 +339,13 @@ static int rockchip_iodomain_probe(struct udevice *dev)
 	struct regmap *grf;
 	int ret;
 
+	struct rockchip_iodomain_priv *priv = dev_get_priv(dev);
+
 	grf = syscon_get_regmap(dev_get_parent(dev));
 	if (IS_ERR(grf))
 		return PTR_ERR(grf);
+	priv->soc_data = soc_data;
+	priv->grf = grf;
 
 	for (int i = 0; i < MAX_SUPPLIES; i++) {
 		const char *supply_name = soc_data->supply_names[i];
@@ -379,4 +391,39 @@ U_BOOT_DRIVER(rockchip_iodomain) = {
 	.of_match = rockchip_iodomain_ids,
 	.bind = rockchip_iodomain_bind,
 	.probe = rockchip_iodomain_probe,
+	.priv_auto = sizeof(struct rockchip_iodomain_priv),
 };
+
+int rockchip_iodomain_set_voltage(struct udevice *supply, int uV)
+{
+	struct udevice *dev;
+	struct uclass *uc;
+
+	uclass_id_foreach_dev(UCLASS_NOP, dev, uc) {
+		struct rockchip_iodomain_priv *priv;
+
+		/* SPL doesn't probe the probe-after-bind devices itself */
+		if (dev->driver != DM_DRIVER_GET(rockchip_iodomain) ||
+		    device_probe(dev))
+			continue;
+		priv = dev_get_priv(dev);
+		for (int i = 0; i < MAX_SUPPLIES; i++) {
+			const char *supply_name = priv->soc_data->supply_names[i];
+			struct udevice *reg;
+
+			if (!supply_name ||
+			    device_get_supply_regulator(dev, supply_name, &reg) ||
+			    reg != supply)
+				continue;
+			if (uV > MAX_VOLTAGE_3_3)
+				return -EINVAL;
+			dev_dbg(dev, "%s: %d uV\n", supply_name, uV);
+
+			return priv->soc_data->write(priv->grf,
+						     priv->soc_data->grf_offset,
+						     i, uV);
+		}
+	}
+
+	return -ENODEV;
+}
diff --git a/drivers/mmc/dw_mmc.c b/drivers/mmc/dw_mmc.c
