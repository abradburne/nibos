diff --git a/drivers/mmc/rockchip_dw_mmc.c b/drivers/mmc/rockchip_dw_mmc.c
index 7a72abaa..bd799b73 100644
--- a/drivers/mmc/rockchip_dw_mmc.c
+++ b/drivers/mmc/rockchip_dw_mmc.c
@@ -5,18 +5,22 @@
 
 #include <clk.h>
 #include <dm.h>
+#include <dm/device_compat.h>
 #include <dt-structs.h>
 #include <dwmmc.h>
 #include <errno.h>
 #include <log.h>
 #include <mapmem.h>
 #include <pwrseq.h>
+#include <rockchip-io-domain.h>
 #include <syscon.h>
 #include <asm/gpio.h>
 #include <asm/arch-rockchip/clock.h>
 #include <asm/arch-rockchip/periph.h>
+#include <dt-bindings/clock/rk3568-cru.h>
 #include <linux/delay.h>
 #include <linux/err.h>
+#include <power/regulator.h>
 
 struct rockchip_mmc_plat {
 #if CONFIG_IS_ENABLED(OF_PLATDATA)
@@ -32,8 +36,229 @@ struct rockchip_dwmmc_priv {
 	int fifo_depth;
 	bool fifo_mode;
 	u32 minmax[2];
+	/* UHS: the IO domain vqmmc feeds follows its voltage */
+	struct udevice *vqmmc;
+	bool io_1v8;
+	struct udevice *vmmc;
+	/* CRU drive phase register, the sample phase is next to it */
+	void __iomem *phase_reg;
+	int sample_phase;	/* degrees, from tuning; -1 if not tuned */
 };
 
+#define ROCKCHIP_MMC_DELAY_SEL		BIT(10)
+#define ROCKCHIP_MMC_DELAYNUM_OFFSET	2
+/* a fine delay element is 44-77 ps; Linux takes 60 */
+#define ROCKCHIP_MMC_DELAY_ELEMENT_PSEC	60
+#define ROCKCHIP_MMC_TUNING_STEPS	36	/* 10 degrees apart */
+
+/*
+ * Set a drive or sample phase of the card clock: 90 degree steps plus up to
+ * 255 fine delay elements (Linux's clk-mmc-phase.c). U-Boot's clock drivers
+ * have no phase support.
+ */
+static void rockchip_dwmmc_set_phase(void __iomem *reg, uint rate, int degrees)
+{
+	u32 delay = 10000000 * (degrees % 90);	/* PSECS_PER_SEC / 10000 / 10 */
+	u32 raw;
+
+	delay = DIV_ROUND_CLOSEST(delay, (rate / 1000) * 36 *
+				  (ROCKCHIP_MMC_DELAY_ELEMENT_PSEC / 10));
+	delay = min(delay, 255U);
+	raw = (delay ? ROCKCHIP_MMC_DELAY_SEL : 0) |
+	      delay << ROCKCHIP_MMC_DELAYNUM_OFFSET | (degrees / 90);
+	writel(raw << 1 | 0x7ff << 17, reg);
+}
+
+static void rockchip_dwmmc_set_phases(struct rockchip_dwmmc_priv *priv,
+				      struct mmc *mmc)
+{
+	bool sdr104 = mmc->selected_mode == UHS_SDR104;
+
+	if (!priv->phase_reg || mmc->clk_disable || !mmc->clock)
+		return;
+	/*
+	 * Hold times as Linux sets them: 90 degrees, 180 at SDR104. The
+	 * sample phase is the tuned one at SDR104, 0 otherwise.
+	 */
+	rockchip_dwmmc_set_phase(priv->phase_reg, mmc->clock, sdr104 ? 180 : 90);
+	rockchip_dwmmc_set_phase(priv->phase_reg + 4, mmc->clock,
+				 sdr104 && priv->sample_phase >= 0 ?
+				 priv->sample_phase : 0);
+}
+
+static int rockchip_dwmmc_set_ios(struct udevice *dev)
+{
+	struct rockchip_dwmmc_priv *priv = dev_get_priv(dev);
+	struct mmc *mmc = mmc_get_mmc_dev(dev);
+	bool v18 = mmc->signal_voltage == MMC_SIGNAL_VOLTAGE_180;
+	int ret;
+
+	/*
+	 * The pads' IO domain must never be at 1.8 V while vqmmc is at 3.3 V:
+	 * switch it to 3.3 V before raising vqmmc, to 1.8 V after lowering
+	 * it (as Linux's io-domain driver does from regulator notifiers).
+	 */
+	if (priv->vqmmc && priv->io_1v8 && !v18) {
+		ret = rockchip_iodomain_set_voltage(priv->vqmmc, 3300000);
+		if (ret)
+			return ret;
+		priv->io_1v8 = false;
+	}
+
+	ret = dwmci_set_ios(dev);
+	if (ret)
+		return ret;
+
+	if (priv->vqmmc && !priv->io_1v8 && v18) {
+		ret = rockchip_iodomain_set_voltage(priv->vqmmc, 1800000);
+		if (ret)
+			return ret;
+		priv->io_1v8 = true;
+	}
+
+	rockchip_dwmmc_set_phases(priv, mmc);
+
+	return 0;
+}
+
+#if CONFIG_IS_ENABLED(MMC_SUPPORTS_TUNING)
+/*
+ * Find the sample phase: read the tuning block at every 10 degrees and take
+ * the middle of the longest run of good reads (Linux's
+ * dw_mci_rk3288_execute_tuning()).
+ */
+static int rockchip_dwmmc_execute_tuning(struct udevice *dev, uint opcode)
+{
+	struct rockchip_dwmmc_priv *priv = dev_get_priv(dev);
+	struct mmc *mmc = mmc_get_mmc_dev(dev);
+	struct dwmci_host *host = &priv->host;
+	const int n = ROCKCHIP_MMC_TUNING_STEPS;
+	bool good[ROCKCHIP_MMC_TUNING_STEPS];
+	int i, start, len, best = -1, best_len = 0, ngood = 0;
+
+	if (!priv->phase_reg)
+		return -ENOSYS;
+
+	/* a read that never starts fails in ~0.5 ms, not 0.1 s */
+	dwmci_writel(host, DWMCI_TMOUT, 0x10000 << 8 | 0xff);
+	for (i = 0; i < n; i++) {
+		rockchip_dwmmc_set_phase(priv->phase_reg + 4, mmc->clock,
+					 i * 360 / n);
+		good[i] = !mmc_send_tuning(mmc, opcode);
+		ngood += good[i];
+	}
+	dwmci_writel(host, DWMCI_TMOUT, 0xffffffff);
+
+	if (ngood == n) {
+		best = 0;
+	} else {
+		for (start = 0; start < n; start++) {
+			if (!good[start] || good[(start + n - 1) % n])
+				continue;
+			for (len = 0; good[(start + len) % n]; len++)
+				;
+			if (len > best_len) {
+				best = (start + len / 2) % n;
+				best_len = len;
+			}
+		}
+	}
+
+	if (best < 0) {
+		priv->sample_phase = -1;
+		rockchip_dwmmc_set_phases(priv, mmc);
+		dev_dbg(dev, "no sample phase works\n");
+		return -EIO;
+	}
+	priv->sample_phase = best * 360 / n;
+	rockchip_dwmmc_set_phases(priv, mmc);
+	dev_dbg(dev, "sample phase %d (%d of %d phases good)\n",
+		priv->sample_phase, ngood, n);
+
+	return 0;
+}
+#endif
+
+/*
+ * A card switched to 1.8 V signalling only goes back to 3.3 V when its power
+ * is cut, which the High Speed retry after a failed UHS boot needs. vmmc is
+ * always-on, so the core can't do it: cut it here, past the regulator's
+ * always-on check, but only then. Powering the card off at every init costs
+ * ~40 ms of card start-up.
+ */
+static int rockchip_dwmmc_host_power_cycle(struct udevice *dev)
+{
+	struct rockchip_dwmmc_priv *priv = dev_get_priv(dev);
+	const struct dm_regulator_ops *ops;
+	int ret;
+
+	if (!priv->vmmc || !priv->io_1v8)
+		return 0;
+	ops = dev_get_driver_ops(priv->vmmc);
+	if (!ops || !ops->set_enable)
+		return -ENOSYS;
+	/* every card init counted one more enable: drop them all */
+	do
+		ret = ops->set_enable(priv->vmmc, false);
+	while (ret == -EBUSY);
+	if (ret)
+		return -ENOSYS;
+	mdelay(20);	/* let it drain */
+	ops->set_enable(priv->vmmc, true);
+	dev_dbg(dev, "card power cut to leave 1.8 V signalling\n");
+
+	return 0;
+}
+
+static const struct dm_mmc_ops rockchip_dwmmc_ops = {
+	.send_cmd	= dwmci_send_cmd,
+	.set_ios	= rockchip_dwmmc_set_ios,
+	.host_power_cycle = rockchip_dwmmc_host_power_cycle,
+#if CONFIG_IS_ENABLED(MMC_SUPPORTS_TUNING)
+	.execute_tuning	= rockchip_dwmmc_execute_tuning,
+#endif
+};
+
+/*
+ * UHS needs 1.8 V signalling, an IO domain that follows vqmmc, and phases
+ * we can set (RK3568 only here). Anything missing leaves High Speed.
+ */
+static void rockchip_dwmmc_setup_uhs(struct udevice *dev,
+				     struct mmc_config *cfg)
+{
+	struct rockchip_dwmmc_priv *priv = dev_get_priv(dev);
+	struct clk drv;
+	int uV;
+
+	if (!CONFIG_IS_ENABLED(MMC_UHS_SUPPORT) ||
+	    !dev_read_bool(dev, "sd-uhs-sdr104") ||
+	    !device_is_compatible(dev, "rockchip,rk3568-dw-mshc"))
+		return;
+
+	if (clk_get_by_name(dev, "ciu-drive", &drv) ||
+	    drv.id < SCLK_SDMMC0_DRV || drv.id > SCLK_EMMC_DRV ||
+	    (drv.id - SCLK_SDMMC0_DRV) % 2)
+		return;
+	/* CRU SDMMC0_CON0 at 0x580, then SDMMC1, SDMMC2, EMMC */
+	priv->phase_reg = dev_read_addr_ptr(drv.dev) + 0x580 +
+			  (drv.id - SCLK_SDMMC0_DRV) * 4;
+	priv->sample_phase = -1;
+
+	if (device_get_supply_regulator(dev, "vqmmc-supply", &priv->vqmmc))
+		return;
+	uV = regulator_get_value(priv->vqmmc);
+	if (uV <= 0 || rockchip_iodomain_set_voltage(priv->vqmmc, uV)) {
+		priv->vqmmc = NULL;
+		return;
+	}
+	priv->io_1v8 = uV <= 1980000;
+	if (device_get_supply_regulator(dev, "vmmc-supply", &priv->vmmc))
+		priv->vmmc = NULL;
+
+	cfg->host_caps |= MMC_CAP(UHS_SDR104) | MMC_CAP(UHS_SDR25) |
+			  MMC_CAP(UHS_SDR12);
+}
+
 static uint rockchip_dwmmc_get_mmc_clk(struct dwmci_host *host, uint freq)
 {
 	struct udevice *dev = host->priv;
@@ -158,6 +383,8 @@ static int rockchip_dwmmc_probe(struct udevice *dev)
 	if (host->buswidth == 8)
 		plat->cfg.host_caps |= MMC_MODE_4BIT;
 
+	rockchip_dwmmc_setup_uhs(dev, &plat->cfg);
+
