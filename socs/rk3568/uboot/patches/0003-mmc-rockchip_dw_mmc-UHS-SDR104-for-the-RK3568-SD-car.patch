@@ -306,7 +306,7 @@ static int dwmci_data_transfer(struct dwmci_host *host, struct mmc_data *data)
 }
 
 static int dwmci_dma_transfer(struct dwmci_host *host, uint flags,
-			      struct bounce_buffer *bbstate)
