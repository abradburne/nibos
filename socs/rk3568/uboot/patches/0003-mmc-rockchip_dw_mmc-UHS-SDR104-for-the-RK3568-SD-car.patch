 	/* Clear interrupts */
 	dwmci_writel(host, host->regs->idsts, DWMCI_IDINTEN_MASK);
@@ -420,8 +430,23 @@ static int dwmci_send_cmd_common(struct dwmci_host *host, struct mmc_cmd *cmd,
 		flags |= DWMCI_CMD_CHECK_CRC;
 
 	host->volt_switching = (cmd->cmdidx == SD_CMD_SWITCH_UHS18V);
-	if (host->volt_switching)
+	if (host->volt_switching) {
 		flags |= DWMCI_CMD_VOLT_SWITCH;
+		/*
+		 * No automatic clock stop while switching to 1.8 V: stopping
+		 * the clock is a step of the switch itself (as Linux does).
+		 * Setting a clock turns low-power mode back on.
+		 */
+		dwmci_writel(host, DWMCI_CLKENA, dwmci_readl(host, DWMCI_CLKENA) &
+			     ~DWMCI_CLKEN_LOW_PWR);
+		dwmci_writel(host, DWMCI_CMD, DWMCI_CMD_START |
+			     DWMCI_CMD_UPD_CLK | DWMCI_CMD_PRV_DAT_WAIT);
+		for (i = 0; i < retry; i++) {
+			if (dwmci_readl(host, DWMCI_RINTSTS) & DWMCI_INTMSK_CDONE)
+				break;
+		}
+		dwmci_writel(host, DWMCI_RINTSTS, DWMCI_INTMSK_ALL);
+	}
 
 	flags |= cmd->cmdidx | DWMCI_CMD_START | DWMCI_CMD_USE_HOLD_REG;
 
@@ -480,8 +505,14 @@ static int dwmci_send_cmd_common(struct dwmci_host *host, struct mmc_cmd *cmd,
 
 	if (data) {
 		ret = dwmci_data_transfer(host, data);
-		if (!host->fifo_mode)
-			ret = dwmci_dma_transfer(host, data->flags, &bbstate);
+		if (!host->fifo_mode) {
+			int dma_ret = dwmci_dma_transfer(host, data->flags,
+							 &bbstate, ret);
+
+			/* a CRC error is the answer, not the DMA's status */
+			if (!ret)
+				ret = dma_ret;
+		}
 	}
 
 	udelay(100);
@@ -490,7 +521,7 @@ static int dwmci_send_cmd_common(struct dwmci_host *host, struct mmc_cmd *cmd,
 }
 
 #ifdef CONFIG_DM_MMC
-static int dwmci_send_cmd(struct udevice *dev, struct mmc_cmd *cmd,
+int dwmci_send_cmd(struct udevice *dev, struct mmc_cmd *cmd,
 			  struct mmc_data *data)
 {
 	struct mmc *mmc = mmc_get_mmc_dev(dev);
@@ -513,7 +544,9 @@ static int dwmci_send_cmd(struct mmc *mmc, struct mmc_cmd *cmd,
 
 static int dwmci_control_clken(struct dwmci_host *host, bool on)
 {
-	const u32 val = on ? DWMCI_CLKEN_ENABLE | DWMCI_CLKEN_LOW_PWR : 0;
+	/* the card needs a running clock to finish a switch to 1.8 V */
+	const u32 val = on ? DWMCI_CLKEN_ENABLE |
+		(host->volt_switching ? 0 : DWMCI_CLKEN_LOW_PWR) : 0;
 	const u32 cmd_only_clk = DWMCI_CMD_PRV_DAT_WAIT | DWMCI_CMD_UPD_CLK;
 	int i, timeout = 10000;
 	u32 flags, mask;
@@ -597,7 +630,7 @@ static int dwmci_setup_bus(struct dwmci_host *host, u32 freq)
 }
 
 #ifdef CONFIG_DM_MMC
-static int dwmci_set_ios(struct udevice *dev)
+int dwmci_set_ios(struct udevice *dev)
 {
 	struct mmc *mmc = mmc_get_mmc_dev(dev);
 #else
@@ -609,7 +642,11 @@ static int dwmci_set_ios(struct mmc *mmc)
 
 	debug("Bus width = %d, clock: %d\n", mmc->bus_width, mmc->clock);
 
-	dwmci_setup_bus(host, mmc->clock);
+	/* The UHS voltage switch gates the clock for a while */
+	if (mmc->clk_disable)
+		dwmci_control_clken(host, false);
+	else
+		dwmci_setup_bus(host, mmc->clock);
 	switch (mmc->bus_width) {
 	case 8:
 		ctype = DWMCI_CTYPE_8BIT;
@@ -629,9 +666,26 @@ static int dwmci_set_ios(struct mmc *mmc)
 		regs |= DWMCI_DDR_MODE;
 	else
 		regs &= ~DWMCI_DDR_MODE;
+	if (mmc->signal_voltage == MMC_SIGNAL_VOLTAGE_180)
+		regs |= DWMCI_UHS_18V;
+	else
+		regs &= ~DWMCI_UHS_18V;
 
 	dwmci_writel(host, DWMCI_UHS_REG, regs);
 
+	/*
+	 * At SDR104/HS200 start reading a block only once the FIFO has room
+	 * for all of it, so the controller never stops the card's clock in
+	 * the middle of one (Linux's dw_mci_ctrl_thld()).
+	 */
+	if ((mmc->selected_mode == UHS_SDR104 ||
+	     mmc->selected_mode == MMC_HS_200) &&
+	    host->fifo_depth * 4 >= MMC_MAX_BLOCK_LEN)
+		dwmci_writel(host, DWMCI_CDTHRCTL,
+			     MMC_MAX_BLOCK_LEN << 16 | DWMCI_CDTHRCTL_RD_EN);
+	else if (dwmci_readl(host, DWMCI_CDTHRCTL))
+		dwmci_writel(host, DWMCI_CDTHRCTL, 0);
+
 	if (host->clksel) {
 		int ret;
 
