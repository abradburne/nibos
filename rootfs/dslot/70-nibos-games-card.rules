# nibos: the games card in TF2 is mounted at /mnt/ds the moment it appears, whatever it is named,
# and unmounted when it is taken out. TF2 is the mmc1 host (the device tree's alias), so its card
# is mmcblk1; its exFAT or FAT volume (the whole card, or a partition) gets /dev/nibos-games-card,
# which /etc/fstab mounts. On a card with several, a volume labelled DS wins, then a nibOS or stock
# card's games partition. The fstab entry is noauto; this starts the mount unit systemd makes
# from it. (An automount made every touch of /mnt/ds wait its device timeout out, 5 s, with no
# card in the slot: a launcher listing games took minutes.)
ACTION!="add|change", GOTO="nibos_games_card_end"
SUBSYSTEM!="block", GOTO="nibos_games_card_end"
KERNEL!="mmcblk1|mmcblk1p[0-9]*", GOTO="nibos_games_card_end"
ENV{ID_FS_TYPE}!="exfat|vfat", GOTO="nibos_games_card_end"
ENV{ID_FS_LABEL}=="DS", OPTIONS+="link_priority=20"
ENV{ID_FS_LABEL}=="NIBOS-DATA|ROMS", OPTIONS+="link_priority=10"
SYMLINK+="nibos-games-card", TAG+="systemd", ENV{SYSTEMD_WANTS}+="mnt-ds.mount"
LABEL="nibos_games_card_end"
