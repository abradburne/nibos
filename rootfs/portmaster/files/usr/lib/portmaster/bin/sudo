#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# sudo, for PortMaster and its ports on nibOS: they run as the user, never as root
# (AGENTS.md, "Permissions"). Ports ask through $ESUDO, which nibOS leaves empty; one that
# calls sudo itself is told no here instead of getting root.
echo "nibOS: ports run as the user; refused: sudo $*" >&2
exit 1
