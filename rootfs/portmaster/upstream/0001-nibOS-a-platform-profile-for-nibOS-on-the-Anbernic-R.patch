         {"paths": {"rd_home_path": "/home/deck/retrodeck", "portmaster_path": "/media/pm"}}))
 
     assert detect(tmp_path)[1] == Path("/media/pm/ports")
+
+
+def test_detect_nibos_games_card(tmp_path):
+    make_dirs(tmp_path, "/usr/lib/nibos", "/mnt/ds/Roms", "/mnt/roms/Roms")
+    (tmp_path / "usr/lib/nibos/board.conf").write_text("NIBOS_BOARD=rg-ds-plus\n")
+    assert detect(tmp_path)[:3] == (
+        Path("/home/user/.local/share"), Path("/mnt/ds/Roms/PORTS"), Path("/mnt/ds/Roms/PORTS"))
+
+
+def test_detect_nibos_roms_partition(tmp_path):
+    make_dirs(tmp_path, "/usr/lib/nibos", "/mnt/roms/Roms")
+    (tmp_path / "usr/lib/nibos/board.conf").write_text("NIBOS_BOARD=rg-ds-plus\n")
+    assert detect(tmp_path)[:3] == (
+        Path("/home/user/.local/share"), Path("/mnt/roms/Roms/PORTS"), Path("/mnt/roms/Roms/PORTS"))
