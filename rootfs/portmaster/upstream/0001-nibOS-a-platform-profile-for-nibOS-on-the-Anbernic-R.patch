@@ -0,0 +1,22 @@
+# SPDX-License-Identifier: MIT
+#
+# nibOS (the Anbernic RG DS+ and friends). PortMaster lives in the user's data folder and
+# everything runs as the user; nibOS's own control.txt (nibos/control.txt) replaces the
+# generic one after every update, as JELOS's and ROCKNIX's do.
+
+import shutil
+
+from .base import PlatformBase
+
+
+class PlatformNibOS(PlatformBase):
+    def first_run(self):
+        self.portmaster_install([])
+
+    def portmaster_install(self, bash_files):
+        """
+        Put nibOS's control.txt in place.
+        """
+        PM_DIR = self.hm.tools_dir / "PortMaster"
+
+        shutil.copy(PM_DIR / "nibos" / "control.txt", PM_DIR / "control.txt")
diff --git a/tests/test_config.py b/tests/test_config.py
