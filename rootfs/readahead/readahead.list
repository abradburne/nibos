# Read by nibos-readahead (a systemd generator) at ~1.4 s into the kernel, in this order:
# what DSlot needs to reach main, then GL (Mesa and its shader cache). Only what comes before
# the shelf's first frame: X11, audio and the rest are left to be read when used. A boot reads
# nearly all of each of these files anyway (mincore after a boot without read-ahead), so they
# are read whole. Paths that do not exist are skipped. @HOME@ is the DSlot user's home
# (install.sh fills it in).
/usr/lib/ld-linux-aarch64.so.1
/usr/lib/libc.so.6
/usr/lib/libm.so.6
/usr/lib/libgcc_s.so.1
/usr/bin/dslot
/usr/lib/libSDL2-2.0.so.0.3200.74
/usr/lib/libSDL3.so.0.4.18
/usr/lib/libudev.so.1.7.15
/usr/lib/libdrm.so.2.134.0
/usr/lib/libgbm.so.1.0.0
/usr/lib/gbm/dri_gbm.so
/usr/lib/libGLdispatch.so.0.0.0
/usr/lib/libEGL.so.1.1.0
/usr/lib/libEGL_mesa.so.0.0.0
/usr/lib/libGLESv2.so.2.1.0
/usr/lib/libexpat.so.1.13.0
/usr/lib/libz.so.1.3.2
/usr/lib/libzstd.so.1.5.7
/usr/lib/libstdc++.so.6.0.35
/usr/lib/libgallium-26.2.4-nibos1.2.so
@HOME@/.cache/mesa_shader_cache/index
