# gba-ds: GBA DS (https://github.com/kyannon/gba-ds), a Game Boy Advance emulator that shows a
# game's map, HUD or status screen on the second screen, for DSlot's GBA DS page on nibOS.
#
# The program is GBA DS's own release build for aarch64 Linux, as published, checked against the
# SHA-256 below. nibOS adds run-game, which starts a game as nibOS needs (both panels, Menu as
# its HOME button, saves in the game's saves folder), and DSlot's description of it
# (files/usr/share/dslot/emulators/gba-ds.toml).
#
# The release links libmgba statically (MPL-2.0). For the GPL's source offer, the package names
# the source the release was built from as well: GBA DS at the release's tag and mGBA at the
# commit it pins (scripts/mgba-options.sh in GBA DS). makepkg fetches and checks them, nothing
# builds from them, and tools/collect-sources.py archives every source the PKGBUILD names.
#
#   cd rootfs/gba-ds && PKGDEST="$PWD/out" BUILDDIR="$HOME/makepkg-build" makepkg -f --nodeps

NIBOS_ROOT=$(cd "$startdir/../.." && pwd)

pkgname=gba-ds
pkgver=1.5
pkgrel=1
pkgdesc="GBA DS: Game Boy Advance games with their map or status screen on the second screen"
url="https://github.com/kyannon/gba-ds"
arch=(aarch64)
# GBA DS GPL-3.0-only; libmgba (linked in) MPL-2.0; rcheevos (linked in) MIT; its font, Jost,
# OFL-1.1; nibOS's run-game and the DSlot description GPL-3.0-or-later.
license=("GPL-3.0-only AND MPL-2.0 AND MIT AND OFL-1.1 AND GPL-3.0-or-later")
depends=(bash sdl2-compat)
# GBA DS's binary as published, byte for byte (it comes stripped).
options=(!strip)
optdepends=('dslot: the GBA DS page that starts its games')

_mgba=143adf5aa2a60c6036810b0cd72445e13d74b0e6
source=("gba-ds-v$pkgver-linux-aarch64.zip::$url/releases/download/v$pkgver/gba-ds-v$pkgver-linux-aarch64.zip"
        "gba-ds-$pkgver-source.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "mgba-$_mgba.tar.gz::https://github.com/mgba-emu/mgba/archive/$_mgba.tar.gz")
noextract=("gba-ds-$pkgver-source.tar.gz" "mgba-$_mgba.tar.gz")
sha256sums=('8471976072381eb6bebbc7c588c407fcea10d6b07ff6888df3a2de3694b97731'
            'c934378f99969b5d434e38e33b482b55358d2d5ecaf853b51573b10bfab1f3bd'
            '32d73531d0fe743cfb27c0e11fb4869d495f6fd6a0162353fb73e29c26af64a7')

check() {
    bash -n "$startdir/files/usr/lib/gba-ds/run-game"
    "$srcdir/gba-ds/gba-ds" --version | grep -qx "GBA DS $pkgver"
}

package() {
    local app="$srcdir/gba-ds"
    install -Dm755 "$app/gba-ds" "$pkgdir/usr/lib/gba-ds/gba-ds"
    install -Dm644 "$app/gba-ds.cfg" "$pkgdir/usr/lib/gba-ds/gba-ds.cfg"
    install -Dm644 "$app/gamecontrollerdb.txt" "$pkgdir/usr/lib/gba-ds/gamecontrollerdb.txt"
    install -Dm644 "$app/README.md" "$pkgdir/usr/lib/gba-ds/README.md"
    cp -r "$app/images" "$pkgdir/usr/lib/gba-ds/"
    install -Dm755 "$startdir/files/usr/lib/gba-ds/run-game" "$pkgdir/usr/lib/gba-ds/run-game"
    install -Dm644 "$startdir/files/usr/share/dslot/emulators/gba-ds.toml" \
        "$pkgdir/usr/share/dslot/emulators/gba-ds.toml"

    local lic="$pkgdir/usr/share/licenses/$pkgname"
    install -Dm644 "$app/licenses/GBA-DS-LICENSE.txt" "$lic/LICENSE"
    install -Dm644 "$app/licenses/mGBA-LICENSE.txt" "$lic/LICENSE.mgba"
    install -Dm644 "$app/licenses/rcheevos-LICENSE.txt" "$lic/LICENSE.rcheevos"
    install -Dm644 "$app/licenses/Jost-OFL.txt" "$lic/OFL.jost"
    install -Dm644 "$app/licenses/README.txt" "$lic/README.txt"
    install -Dm644 "$NIBOS_ROOT/LICENSE" "$lic/LICENSE.nibos"
}
