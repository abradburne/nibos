 }
 
-static void
-panfrost_bo_munmap(struct panfrost_bo *bo)
-{
-   PAN_TRACE_FUNC(PAN_TRACE_GL_BO);
-
-   if (!bo->ptr.cpu)
-      return;
-
-   if (os_munmap((void *)(uintptr_t)bo->ptr.cpu, panfrost_bo_size(bo))) {
