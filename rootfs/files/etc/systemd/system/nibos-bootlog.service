# nibos (rootfs/make-arch.sh): every start leaves its logs on the ROMS volume (bootlog), 20 s
# in; nibos-bootlog-shutdown.service writes them again, complete, at power-off and restart.
[Unit]
Description=Save this start's logs to the ROMS volume
RequiresMountsFor=/mnt/roms
After=multi-user.target

[Service]
# Simple, not oneshot: its 20 s wait would hold the start-up open (is-system-running
# "starting"), and with it what waits for the start-up to finish (the deferred network mode,
# nibos-radios-restore).
Type=simple
ExecStart=/usr/lib/nibos/bootlog

[Install]
WantedBy=multi-user.target
