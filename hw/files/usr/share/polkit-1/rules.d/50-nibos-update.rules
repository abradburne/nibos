// nibos-hw: the wheel group may start and stop the system update's steps
// (nibos-update@<step>.service: `nib update`, DSlot's Update page) without a password.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.isInGroup("wheel")) {
        var unit = action.lookup("unit") || "";
        if (unit.indexOf("nibos-update@") == 0) return polkit.Result.YES;
    }
});
