# nibos-hw: confirm the running A/B slot once its boot UI is up (docs/design/ab-rollback.md):
# the splash has seen both screens taken over (at most 2 minutes' wait, for a boot without it),
# and 30 s later DSlot, if it's the boot UI, is still running rather than in the safe mode.
# Until then SPL counts this boot as one of the slot's tries. Nothing to do on a confirmed slot,
# or a card with no boot control block.
[Unit]
Description=Confirm the running slot once the boot UI is up
After=multi-user.target

[Service]
# Simple, not oneshot: on a slot's trial boot the 30 s watch would hold the start-up open
# (is-system-running "starting"), and with it what waits for the start-up to finish: the
# radios left on came back half a minute late after every update (nibos-radios-restore), and
# DSlot showed Wi-Fi off meanwhile. An update tried on this slot is done once it is confirmed
# (nibos-update booted), as when it was this unit's ExecStartPost.
Type=simple
ExecStart=/bin/sh -c '/usr/bin/nibos-bootctl confirm-when-up && { /usr/bin/nibos-update booted || true; }'

[Install]
WantedBy=multi-user.target
