# nibOS: what every nibOS kernel has, whatever the board. Merged over the
# arm64 defconfig by build.sh, before the SoC's and the board's fragments
# (socs/<soc>/kernel/, boards/<board>/kernel/), which win where they differ.
#
# Every MB of Image.gz costs the bootloader ~0.07 s to read and unpack, so
# what nothing uses before the root file system is a module or off.

# --- Display, sound and the stacks the boards' drivers sit on ---------------

CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
# No Sound Open Firmware DSPs on these SoCs.
# CONFIG_SND_SOC_SOF_TOPLEVEL is not set
CONFIG_RFKILL=y
# There is no initramfs, so drivers that load firmware are modules (they would
# probe before /usr/lib/firmware is mounted), and the Wi-Fi and Bluetooth
# stacks under them load with them, after the root file system is up.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HIDP=m
CONFIG_INITRAMFS_SOURCE=""

# --- Input: the hardware layer's gamepad, Bluetooth and USB controllers -----

CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y

# --- Storage and file systems -----------------------------------------------

# The cards' ROMS (FAT) and games (exFAT) volumes.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXFAT_FS=m
# USB sticks and SCSI-like disks: modules, never on the boot path.
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_SQUASHFS=m
CONFIG_NFS_FS=m
# CONFIG_IP_PNP is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_MTD_UBI is not set
# CONFIG_MD is not set

# Compressed swap in RAM (nibos-zram), and zswap.
CONFIG_ZRAM=y
CONFIG_ZSWAP=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# --- Console ------------------------------------------------------------------

# Terminus 16x32, picked on the command line (fbcon=font:TER16x32): nothing
# loads a font during start-up.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# --- Power ----------------------------------------------------------------------

# The performance governor while booting; nibos-cpufreq hands over to
# schedutil once booted.
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Utilisation clamping: a program may ask schedutil for a minimum clock for
# its own threads (sched_setattr's sched_util_min, no root needed), so a game
# that sleeps to vblank isn't run at the lowest clock that just keeps up; with
# the group variant, a unit's cgroup can have one (cpu.uclamp.min).
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# Suspend is tested often (docs/engineering/suspend-and-wifi.md): keep
# pm_test and the suspend statistics.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# A handheld with 1-4 GB doesn't hibernate, kexec or keep crash dumps.
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set

# --- Security and the crypto iwd uses -----------------------------------------

CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_DES=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# --- USB gadget -----------------------------------------------------------------

CONFIG_USB_G_SERIAL=m

# --- Not used on a handheld -----------------------------------------------------

# Booted by U-Boot from a FIT, never through EFI.
# CONFIG_EFI is not set
# CONFIG_EFIVAR_FS is not set
# CONFIG_FB_EFI is not set
# CONFIG_RTC_DRV_EFI is not set
# No VMs, as a guest or a host.
# CONFIG_VFIO is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_VHOST_MENU is not set
# Laptop and server platforms.
# CONFIG_CHROME_PLATFORMS is not set
# CONFIG_CROS_EC is not set
# CONFIG_MFD_CROS_EC_DEV is not set
# CONFIG_GOOGLE_FIRMWARE is not set
# CONFIG_SURFACE_PLATFORMS is not set
# CONFIG_TCG_TPM is not set
# CONFIG_TEE is not set
# CONFIG_IPMI_HANDLER is not set
# CONFIG_FPGA is not set
# CONFIG_HTE is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_RPMSG is not set
# Cameras and TV: modules for whoever plugs one in.
CONFIG_MEDIA_SUPPORT=m
# One NUMA node.
# CONFIG_NUMA is not set
# The kernel unpacks no initramfs, so only gzip (defconfig's) is kept.
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set

# --- Debugging --------------------------------------------------------------------

# /proc/config.gz as a module; no debug info or boot-time self tests.
CONFIG_IKCONFIG=m
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_MEMTEST is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_NONE=y

# Measured on the RG DS+ (2026-10-21; boot, idle current, two DSperate scenes; neutral within
# the noise, kept): 3-level page tables (39-bit VA, as Android's), MGLRU for a 1 GB device
# under memory pressure, and no audit subsystem (nothing reads it; a smaller kernel).
CONFIG_ARM64_VA_BITS_39=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_AUDIT is not set

CONFIG_LOCALVERSION="-nibos"

# A hung kernel restarts rather than stays dark: a panic reboots after 10 s, and a CPU stuck
# in the kernel (soft lockup: no scheduling for 20 s; hard lockup: no interrupts, seen by
# another CPU, the "buddy" detector) panics. systemd feeds the hardware watchdog for a
# userspace that stops (nibos-hw's system.conf.d/50-nibos-watchdog.conf).
CONFIG_PANIC_TIMEOUT=10
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
