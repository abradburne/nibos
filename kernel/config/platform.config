# nibOS: applied with the platform trim, before every other fragment: build.sh
# turns off every ARCH_* platform but the SoC's (soc.sh), and these with them.
# Run through olddefconfig on their own first, as the options that depend on
# them settle before the rest is merged.
# CONFIG_ACPI is not set
# CONFIG_KVM is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
