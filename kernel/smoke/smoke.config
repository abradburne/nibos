# nibOS: the smoke-test kernel (SMOKE=1 build.sh). Its initramfs carries the
# firmware, so the drivers that load firmware are built in, and their stacks
# with them; the board adds its own (boards/<board>/kernel/smoke.config).
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BT=y
CONFIG_BT_HIDP=y
